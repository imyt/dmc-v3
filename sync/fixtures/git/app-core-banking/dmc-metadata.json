{
  "systems": [
    {
      "name": "shop-oltp",
      "platform": "PostgreSQL",
      "environment": "prod",
      "schemas": [
        {
          "name": "public",
          "tables": [
            {
              "name": "orders",
              "kind": "table",
              "columns": [
                {
                  "name": "id",
                  "data_type": "bigint",
                  "nullable": false
                },
                {
                  "name": "customer_ref",
                  "data_type": "bigint"
                },
                {
                  "name": "total",
                  "data_type": "numeric"
                },
                {
                  "name": "state",
                  "data_type": "text",
                  "nullable": false,
                  "description": "Order state",
                  "sample_values": [
                    "SECRET-1",
                    "SECRET-2"
                  ]
                }
              ]
            },
            {
              "name": "customers",
              "kind": "table",
              "columns": [
                {
                  "name": "id",
                  "data_type": "bigint",
                  "nullable": false
                },
                {
                  "name": "first_name",
                  "data_type": "text"
                },
                {
                  "name": "last_name",
                  "data_type": "text"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
