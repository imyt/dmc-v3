{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmc.internal/workflow.schema.json",
  "title": "DMC workflow definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow", "version", "start", "steps"],
  "properties": {
    "workflow": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "start": { "type": "string" },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/task" }, { "$ref": "#/$defs/action" }, { "$ref": "#/$defs/branch" },
          { "$ref": "#/$defs/parallel" }, { "$ref": "#/$defs/join" }, { "$ref": "#/$defs/end" }
        ]
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object", "additionalProperties": false, "required": ["type", "assignee", "decisions"],
      "properties": {
        "type": { "const": "task" },
        "title": { "type": "string" },
        "assignee": { "type": "string", "description": "role or rule name; resolved to a person when the task is created" },
        "decisions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" }, "description": "decision -> next step" },
        "sla": { "type": "string", "pattern": "^[1-9][0-9]*[mhd]$" },
        "sla_context": { "type": "string", "description": "instance context key that holds a duration like 10d; overrides sla" },
        "escalate_to": { "type": "string" }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["type", "action", "next"],
      "properties": { "type": { "const": "action" }, "action": { "type": "string" }, "next": { "type": "string" } }
    },
    "branch": {
      "type": "object", "additionalProperties": false, "required": ["type", "branches", "default"],
      "properties": {
        "type": { "const": "branch" },
        "branches": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["when", "next"], "properties": { "when": { "type": "string" }, "next": { "type": "string" } } } },
        "default": { "type": "string" }
      }
    },
    "parallel": {
      "type": "object", "additionalProperties": false, "required": ["type", "branches"],
      "properties": { "type": { "const": "parallel" }, "branches": { "type": "array", "minItems": 2, "items": { "type": "string" } } }
    },
    "join": {
      "type": "object", "additionalProperties": false, "required": ["type", "parallel", "next"],
      "properties": { "type": { "const": "join" }, "parallel": { "type": "string" }, "next": { "type": "string" } }
    },
    "end": {
      "type": "object", "additionalProperties": false, "required": ["type", "outcome"],
      "properties": { "type": { "const": "end" }, "outcome": { "type": "string" } }
    }
  }
}
